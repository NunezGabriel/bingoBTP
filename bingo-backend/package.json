{
  "name": "bingo-backend",
  "version": "2.0.0",
  "description": "API de Misti Quest, la plataforma de dinamicas gamificadas de GDG Arequipa",
  "main": "src/app.js",
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "generate": "node node_modules/prisma/build/index.js generate",
    "migrate": "prisma migrate deploy",
    "seed": "node prisma/seed.js",
    "seed:reset": "node prisma/seed.js --reset",
    "test": "node scripts/smoke-test.js",
    "loadtest": "node scripts/load-test.js",
    "demo": "node scripts/demo-players.js",
    "db": "node scripts/db.js",
    "db:stop": "node scripts/db.js stop"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^7.5.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "nodemonConfig": {
    "watch": [
      "src",
      ".env"
    ]
  }
}
