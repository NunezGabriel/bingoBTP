// Bingo GDG - la app de los eventos de GDG Arequipa.
//
// Modelo mental:
//   Player       = la persona. Entra con usuario y clave; su rol decide que ve.
//   Event        = un evento (DevFest, I/O Extended...). Solo uno abierto a la vez.
//   EventPlayer  = inscripcion de un jugador a un evento y sus puntos ahi.
//   Round        = una ronda de bingo: al crearla todos reciben cartilla nueva.
//   Card / Cell  = la cartilla de 9 casillas y cada casilla con quien la firmo.
//   MissionClaim = una mision de la tarjeta, validada por un admin con el QR.
//   PointLedger  = libro de puntos. Su clave unica (evento, jugador, refKey)
//                  evita cobrar dos veces lo mismo.
//
// Lo que NO esta en la base: las preguntas del bingo, las misiones y los
// personajes se editan en el codigo, en src/content/. La posicion de cada
// quien en el lobby vive solo en memoria: no tiene sentido guardarla.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PLAYER
  ADMIN
}

enum EventStatus {
  DRAFT
  LIVE
  CLOSED
}

enum RoundStatus {
  COUNTDOWN
  ACTIVE
  ENDED
}

model Player {
  id             Int      @id @default(autoincrement())
  /// Usuario tal como lo escribio; es tambien el nombre sobre su personaje.
  name           String
  /// El mismo en minusculas: unico sin importar mayusculas ni tildes.
  nameKey        String   @unique
  claveHash      String
  /// PLAYER no ve nada de admin; ADMIN no juega: no tiene cartilla ni lobby.
  role           Role     @default(PLAYER)
  /// Personaje elegido (id de src/content/skins.js). Null hasta que elige.
  skin           String?
  /// Se incrementa al cambiar la clave: invalida las sesiones abiertas.
  sessionVersion Int      @default(1)
  /// Codigo de 6 caracteres: se dicta para firmar y es lo que lleva su QR.
  code           String   @unique
  createdAt      DateTime @default(now())

  events    EventPlayer[]
  ledger    PointLedger[]
  cards     Card[]
  signed    Cell[]
  missions  MissionClaim[] @relation("MissionOwner")
  validated MissionClaim[] @relation("MissionValidator")
}

model Event {
  id        Int         @id @default(autoincrement())
  name      String
  status    EventStatus @default(DRAFT)
  createdAt DateTime    @default(now())
  startedAt DateTime?
  closedAt  DateTime?

  players  EventPlayer[]
  ledger   PointLedger[]
  rounds   Round[]
  missions MissionClaim[]
}

model EventPlayer {
  id           Int       @id @default(autoincrement())
  eventId      Int
  playerId     Int
  points       Int       @default(0)
  /// Desempate del ranking: a igual puntaje gana quien llego primero.
  lastScoredAt DateTime?
  finalRank    Int?
  joinedAt     DateTime  @default(now())

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([eventId, playerId])
  @@index([eventId, points])
}

model PointLedger {
  id        Int      @id @default(autoincrement())
  eventId   Int
  playerId  Int
  amount    Int
  /// Identificador de la recompensa, ej. "r12:cell:4", "r12:bingo",
  /// "mision:redes", "ajuste:<uuid>".
  refKey    String
  label     String
  createdAt DateTime @default(now())

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([eventId, playerId, refKey])
  @@index([eventId, createdAt])
}

model Round {
  id             Int         @id @default(autoincrement())
  eventId        Int
  /// Ronda 1, 2, 3... del evento.
  number         Int
  status         RoundStatus @default(COUNTDOWN)
  /// Fin de la cuenta regresiva: desde aqui se puede firmar.
  startsAt       DateTime
  endedAt        DateTime?
  cellPoints     Int         @default(5)
  completePoints Int         @default(50)
  createdAt      DateTime    @default(now())

  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  cards Card[]

  @@unique([eventId, number])
  @@index([eventId, status])
}

model Card {
  id            Int       @id @default(autoincrement())
  roundId       Int
  playerId      Int
  completedAt   DateTime?
  /// Orden de llegada: 1 = primero en completar la ronda.
  completedRank Int?
  createdAt     DateTime  @default(now())

  round  Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  cells  Cell[]

  @@unique([roundId, playerId])
  @@index([roundId, completedRank])
}

model Cell {
  id         Int       @id @default(autoincrement())
  cardId     Int
  position   Int
  /// La pregunta de la casilla (sale de src/content/bingo.js al repartir).
  text       String
  signedById Int?
  signedAt   DateTime?

  card     Card    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  signedBy Player? @relation(fields: [signedById], references: [id], onDelete: SetNull)

  @@unique([cardId, position])
  /// Una misma persona no puede firmar dos casillas de la misma cartilla.
  @@unique([cardId, signedById])
}

model MissionClaim {
  id            Int      @id @default(autoincrement())
  eventId       Int
  playerId      Int
  /// id de la mision en src/content/missions.js
  missionId     String
  /// El admin que escaneo su QR. Queda para poder auditar los premios.
  validatedById Int
  createdAt     DateTime @default(now())

  event       Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  player      Player @relation("MissionOwner", fields: [playerId], references: [id], onDelete: Cascade)
  validatedBy Player @relation("MissionValidator", fields: [validatedById], references: [id])

  /// Una mision se valida una sola vez por persona y evento.
  @@unique([eventId, playerId, missionId])
  @@index([eventId, createdAt])
}
