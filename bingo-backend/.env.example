# Plantilla de variables de la API de Misti Quest. Copiar a .env y rellenar.
#
# LOCAL:  copia este archivo a .env
# RENDER: define estas mismas claves en Environment (menos PORT, lo pone Render)

# ---- Base de datos ----
# Local (sin Docker): npm run db   (o desde la raiz del proyecto: npm run dev)
DATABASE_URL=postgres://postgres:postgres@localhost:52611/template1?sslmode=disable
# Solo para `prisma migrate dev` en local
SHADOW_DATABASE_URL=postgres://postgres:postgres@localhost:52612/template1?sslmode=disable
# Produccion con Neon: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
#   IMPORTANTE: crea el proyecto de Neon en la MISMA region que tu servidor de API.
#   Cada accion del juego hace varias consultas; a 150 ms cada una se nota.

# Conexiones simultaneas a la base.
#   Local con `prisma dev`: 1 (esa base no soporta varias a la vez)
#   Produccion (Neon pooler o Postgres real): 20
DB_POOL_MAX=1

# ---- Servidor ----
# Local: 3001. En Render NO definirlo (lo inyecta la plataforma).
PORT=3001
# Local: development | Produccion: production
NODE_ENV=development
# Saltos de proxy para leer la IP real: 1 (nginx o Render directo), 2 (Vercel -> Render)
TRUST_PROXY=1

# ---- Sesion ----
# Firma de la cookie. En produccion minimo 16 caracteres aleatorios:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia-esto-por-un-valor-aleatorio
# Por defecto: production => secure + sameSite=none. Con HTTP en red local: COOKIE_SECURE=false
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax

# ---- CORS ----
FRONTEND_URL=http://localhost:3000
# FRONTEND_URLS=https://otro-dominio.com

# ---- Cuenta admin inicial ----
# Se crea sola al arrancar si no existe (util en Render, que no tiene consola gratis).
# Si ese nombre ya existe con otro PIN, NO se toca.
ADMIN_NICKNAME=gdgadmin
ADMIN_PIN=cambia-a-6-digitos
