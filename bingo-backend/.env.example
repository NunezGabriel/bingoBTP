# Plantilla de variables del backend. Copiar a .env y rellenar.
#
# LOCAL:  copia este archivo a .env y usa los valores comentados como "local"
# RENDER: define estas mismas claves en Environment (menos PORT, lo pone Render)

# Cadena de conexion Postgres (Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require

# Puerto del servidor. Local: 3001. En Render NO definirlo (lo inyecta la plataforma).
PORT=3001

# Local: development  |  Render: production
# Controla la cookie de sesion: production => secure=true + sameSite=none
NODE_ENV=development

# Secreto para firmar la cookie de sesion. Usar un valor largo y aleatorio en produccion.
SESSION_SECRET=cambia-esto-por-un-valor-aleatorio

# Origen del frontend permitido por CORS
# Local:  http://localhost:3000
# Render: https://bingo-btp.vercel.app
FRONTEND_URL=http://localhost:3000

# Opcional: origenes adicionales separados por coma
# FRONTEND_URLS=https://otro-dominio.com
