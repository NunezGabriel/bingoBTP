# Variables del despliegue de Misti Quest con Docker Compose.
# Copiar a .env en la raiz del proyecto:  cp .env.docker.example .env
#
# OJO: este .env es el del servidor. Los .env dentro de bingo-backend/
# y bingo-frontend/ son para desarrollo local y no se usan aqui.

# ---- Postgres del contenedor ----
POSTGRES_DB=misti
POSTGRES_USER=misti_user
POSTGRES_PASSWORD=cambia-esta-password

# ---- Conexion del backend ----
# "postgres" es el nombre del servicio en docker-compose, no un host real.
DATABASE_URL=postgresql://misti_user:cambia-esta-password@postgres:5432/misti
# Con la base en el mismo servidor cada consulta tarda ~1 ms: puedes subir el pool.
DB_POOL_MAX=20

# ---- Sesion ----
# Generar con: openssl rand -hex 32
SESSION_SECRET=cambia-esto-por-un-valor-aleatorio-largo

# ---- Cookie ----
# false = servido por HTTP en red local (lo normal al inicio).
# true  = servido por HTTPS con certificado valido.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---- Origen permitido por CORS ----
# Con nginx delante todo es mismo origen, pero se deja explicito.
# Poner la IP o dominio real con el que se accede al servidor.
FRONTEND_URL=http://192.168.1.100

# ---- Puerto que expone nginx en el host ----
HTTP_PORT=80

# ---- Cuenta admin inicial (se crea al arrancar) ----
ADMIN_NICKNAME=gdgadmin
ADMIN_PIN=cambia-a-6-digitos

# ---- Contenido de ejemplo ----
# true la primera vez: crea un evento de ejemplo (sin abrir). Las preguntas del
# bingo y las misiones van en el codigo, en bingo-backend/src/content/.
SEED_ON_START=true
