# Plantilla de variables del frontend. Copiar a .env.local para desarrollo.

# Base de las llamadas del cliente (lib/api.ts).
# Dejar en /api para usar el proxy de next.config.ts (evita CORS y cookies cross-site).
NEXT_PUBLIC_API_URL=/api

# Backend al que el proxy /api reenvia las peticiones (next.config.ts).
# Local:  http://localhost:3001
# Vercel: no definirla -> usa https://bingobtp.onrender.com por defecto
BACKEND_URL=http://localhost:3001

# WebSocket del lobby: va DIRECTO al backend, porque ni el rewrite de Next ni el
# de Vercel reenvian conexiones WebSocket.
# Local:  ws://localhost:3001/ws/lobby
# Vercel: wss://bingobtp.onrender.com/ws/lobby
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws/lobby
